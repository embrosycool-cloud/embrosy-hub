    rBtn.BackgroundColor3 = autoReturn and C.purple or C.dark
end)

fBtn.MouseButton1Click:Connect(teleportForward)

uBtn.MouseButton1Click:Connect(function()
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = hrp.CFrame * CFrame.new(0, 20, 0)
    end
end)

lfBtn.MouseButton1Click:Connect(teleportToFirstSpot)

rfBtn.MouseButton1Click:Connect(function()
    autoReturnT = not autoReturnT
    rfBtn.Text = autoReturnT and "AUTO RETURN: ON" or "AUTO RETURN: OFF"
    rfBtn.BackgroundColor3 = autoReturnT and C.purple or C.dark
end)

-- Keybinds
UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.K then main.Visible = not main.Visible end
    if input.KeyCode == Enum.KeyCode.T then tMenu.Visible = not tMenu.Visible end
    if input.KeyCode == Enum.KeyCode.R then teleportToFirstSpot() end 
    if input.KeyCode == Enum.KeyCode.C then teleportForward() end 
end)

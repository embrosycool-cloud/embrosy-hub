-- Logique TP First Spot (Keybind R)
local function teleportToFirstSpot()
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if hrp and firstSpot then
        if autoReturnT then
            local old = hrp.CFrame
            hrp.CFrame = firstSpot
            task.wait(0.1)
            hrp.CFrame = old
        else
            hrp.CFrame = firstSpot
        end
    end
end

-- Logique TP Forward (Keybind C)
local function teleportForward()
    local hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = hrp.CFrame * CFrame.new(0, 0, -5)
    end
end

-- Events Boutons
sBtn.MouseButton1Click:Connect(function()
